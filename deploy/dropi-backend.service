[Unit]
Description=Dropi Manager backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/dropi-manager/backend
ExecStart=__HOME__/dropi-manager/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
