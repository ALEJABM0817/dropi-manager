[Unit]
Description=Dropi Manager backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=dropi
WorkingDirectory=/home/dropi/dropi-manager/backend
ExecStart=/home/dropi/dropi-manager/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
